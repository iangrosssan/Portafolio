---
layout: base.njk
pageTitle: Portafolio Académico
activeRepo: academico
---

<div class="page">

    {% include "header-minimal.njk" %}

    <section class="layout">
        <div class="sidebar">
            <nav class="panel">
                <strong class="desktop-only" style="font-size:.7rem; letter-spacing:.08em; text-transform:uppercase; color:#64748b;">
                    Proyectos
                </strong>
                <details class="mobile-dropdown" open>
                    <summary class="nav-item active mobile-only">
                        <span id="mobile-summary-academico">{{ site.academic_projects[0].title }}</span>
                        <span class="dropdown-chevron">▼</span>
                    </summary>
                    <div id="academico" class="subnav">
                        {% for project in site.academic_projects %}
                        <button class="nav-item {% if loop.first %}active{% endif %}" id="{{ project.id }}"
                            onclick="event.stopPropagation(); showPDF('{{ project.id }}', '{{ project.filename }}')">
                            {{ project.title }}
                            {% for tag in project.tags %}
                            <span class="tag">{{ tag }}</span>
                            {% endfor %}
                        </button>
                        {% endfor %}
                    </div>
                </details>
            </nav>
        </div>

        <main aria-label="Vista previa">
            <div class="doc-summary" id="doc-summary">
                <strong>Resumen</strong>
                <em id="doc-title">{{ site.academic_projects[0].title }}</em>
                <span id="doc-text">
                    {{ site.academic_projects[0].text }}
                </span>
                <a id="video-btn" class="demo-btn desktop-only" href="{{ site.academic_projects[0].youtubeUrl }}" target="_blank" rel="noopener" style="display: {% if site.academic_projects[0].youtubeUrl %}inline-flex{% else %}none{% endif %};">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    Ver en YouTube
                </a>
            </div>
            <a id="mobile-video-btn" href="{{ site.academic_projects[0].youtubeUrl }}" target="_blank" class="mobile-action-btn mobile-only" style="display: {% if site.academic_projects[0].youtubeUrl %}block{% else %}none{% endif %}; margin-bottom: -0.75rem;">Ver en YouTube</a>
            <a id="mobile-pdf-btn" href="{{ site.academic_projects[0].filename | url }}" target="_blank" class="mobile-action-btn mobile-only">Ver PDF del Proyecto</a>
            <iframe id="viewer" src="{{ site.academic_projects[0].filename | url }}"
                title="{{ site.academic_projects[0].title }}"></iframe>
        </main>
    </section>

    {% include "footer.njk" %}

</div>

<script src="{{ '/js/app.js' | url }}?v=10"></script>
