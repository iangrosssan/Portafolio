---
layout: base.njk
pageTitle: Portafolio de Código
activeRepo: codigo
---

<div class="page">

    {% include "header-minimal.njk" %}

    <section class="layout">
        <div class="sidebar">
            <nav class="panel">
                <strong class="desktop-only" style="font-size:.7rem; letter-spacing:.08em; text-transform:uppercase; color:#64748b;">
                    Proyectos
                </strong>
                <details class="mobile-dropdown" open>
                    <summary class="nav-item active mobile-only">
                        <span id="mobile-summary-codigo">{{ site.code_projects[0].title }}</span>
                        <span class="dropdown-chevron">▼</span>
                    </summary>
                    <div id="codigo" class="subnav">
                        {% for project in site.code_projects %}
                        <button class="nav-item {% if loop.first %}active{% endif %}" id="{{ project.id }}" onclick="showCode('{{ project.id }}')">
                            {{ project.title }}
                            {% for tag in project.tags %}
                            <span class="tag">{{ tag }}</span>
                            {% endfor %}
                        </button>
                        {% endfor %}
                    </div>
                </details>
            </nav>
        </div>

        <main aria-label="Vista previa">
            <div class="doc-summary has-demo" id="doc-summary">
                <strong>Resumen</strong>
                <em id="doc-title">{{ site.code_projects[0].title }}</em>
                <span id="doc-text">
                    {{ site.code_projects[0].text }}
                </span>
                <a id="demo-btn" class="demo-btn" href="{{ site.code_projects[0].demoUrl }}" target="_blank" rel="noopener" style="display: {% if site.code_projects[0].demoUrl %}inline-flex{% else %}none{% endif %};">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    Demo
                </a>
            </div>
            <a id="mobile-code-btn" href="https://github.com/{{ site.code_projects[0].repo }}" target="_blank" class="mobile-action-btn">Ver Repositorio GitHub</a>
            <iframe id="viewer" src="{{ '/repo-viewer.html' | url }}#{{ site.code_projects[0].repo }}"
                title="Vista de Repositorio"></iframe>
        </main>
    </section>

    {% include "footer.njk" %}

</div>

<script src="{{ '/js/app.js' | url }}?v=10"></script>
