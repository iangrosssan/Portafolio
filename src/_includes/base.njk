<!doctype html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{ pageTitle }} — {{ site.name }}</title>
    <meta name="description" content="{{ site.lead }}">
    <meta name="keywords" content="Aerospace Pioneer, CubeSat structural design, Aerospace vibration testing, Ingeniería aeroespacial Chile, Spacecraft structures engineer, Simcenter 3D FEA, NASA GMAT simulation, Quasi-static load analysis, Resonance analysis, Random vibration analysis, Python scientific computing, Engineering tools, Web scraping Python, Enterprise resources planning, Arquitectura de Datos">
    <meta name="author" content="{{ site.name }}">
    <link rel="canonical" href="https://iangrosssan.github.io/Portafolio{{ page.url | url }}">
    
    <!-- Open Graph / LinkedIn / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://iangrosssan.github.io/Portafolio{{ page.url | url }}">
    <meta property="og:title" content="{{ pageTitle }} — {{ site.name }}">
    <meta property="og:description" content="{{ site.lead }}">
    <meta property="og:site_name" content="{{ site.name }} Portfolio">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }} — {{ site.name }}">
    <meta name="twitter:description" content="{{ site.lead }}">

    <!-- Schema.org / JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "{{ site.name }}",
      "url": "https://iangrosssan.github.io/Portafolio/",
      "jobTitle": "Aerospace & Systems Engineer",
      "description": "{{ site.lead }}",
      "sameAs": [
        "{{ site.links.linkedin }}",
        "{{ site.links.github }}",
        "{{ site.links.youtube }}",
        "{{ site.links.instagram }}"
      ]
    }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/css/style.css' | url }}?v=29">
    <style>
        :root {
            --bg-dark: {{ theme.palette.background.solid }};
            --bg-gradient: {{ theme.palette.background.solid }};
            --panel-bg: {{ theme.palette.panels.background }};
            --panel-border: {{ theme.palette.panels.border }};
            --panel-blur: blur({{ theme.palette.panels.blur }});
            --ink: {{ theme.palette.typography.primary }};
            --muted: {{ theme.palette.typography.muted }};
            --accent: {{ theme.palette.accents.primary }};
            --accent-secondary: {{ theme.palette.accents.secondary }};
            --accent-glow: rgba(254, 88, 3, 0.4);
            
            --font-display: {{ theme.typography.display }};
            --font-interface: {{ theme.typography.interface }};
            
            --hero-gradient: {{ theme.gradients.hero_title | safe }};
        }
    </style>
</head>

<body>
    {{ content | safe }}
    
    <script>
    (function() {
        const wisps = [
            { el: null, x: 0, y: 0, targetX: 0, targetY: 0, lag: 0.15, drift: 0 },
            { el: null, x: 0, y: 0, targetX: 0, targetY: 0, lag: 0.08, drift: 0.02 },
            { el: null, x: 0, y: 0, targetX: 0, targetY: 0, lag: 0.04, drift: 0.05 }
        ];

        let mouseX = window.innerWidth / 2, mouseY = window.innerHeight / 2;
        let isActive = true;

        // Initialize wisp positions to avoid jump
        wisps.forEach(w => { w.x = mouseX; w.y = mouseY; });
        
        // Start animation immediately
        requestAnimationFrame(animate);

        function updateTracking(e) {
            const touch = e.touches ? e.touches[0] : e;
            mouseX = touch.clientX;
            mouseY = touch.clientY;

            if (!isActive) {
                isActive = true;
                animate();
            }
        }

        document.addEventListener('mousemove', updateTracking);
        document.addEventListener('touchstart', updateTracking, { passive: true });
        document.addEventListener('touchmove', updateTracking, { passive: true });

        function animate() {
            let moving = false;
            const now = Date.now() * 0.001;
            
            // Re-fetch wisps in case they was just rendered
            wisps[0].el = document.getElementById('wisp-1');
            wisps[1].el = document.getElementById('wisp-2');
            wisps[2].el = document.getElementById('wisp-3');

            const heroPanel = document.getElementById('hero-panel');
            const heroRect = heroPanel ? heroPanel.getBoundingClientRect() : { left: 0, top: 0 };
            
            wisps.forEach((w, i) => {
                const driftX = Math.sin(now + i) * 30 * w.drift;
                const driftY = Math.cos(now * 0.7 + i) * 20 * w.drift;
                
                w.x += (mouseX + driftX - w.x) * w.lag;
                w.y += (mouseY + driftY - w.y) * w.lag;

                if (Math.abs(mouseX - w.x) > 0.1) moving = true;

                if (w.el) {
                    const rotate = Math.sin(now * 0.5 + i) * 15 * w.drift;
                    const scale = 1 + Math.sin(now + i) * 0.1 * w.drift;
                    const offsetX = w.el.offsetWidth / 2;
                    const offsetY = w.el.offsetHeight / 2;
                    // Apply relative transform for the hero panel
                    w.el.style.transform = `translate(${w.x - heroRect.left - offsetX}px, ${w.y - heroRect.top - offsetY}px) rotate(${rotate}deg) scale(${scale})`;
                    w.el.style.opacity = '1';
                }
            });

            // Set global glow coordinates for fixed backgrounds
            document.documentElement.style.setProperty('--glow-x', wisps[0].x + 'px');
            document.documentElement.style.setProperty('--glow-y', wisps[0].y + 'px');

            if (moving || isActive) {
                requestAnimationFrame(animate);
            } else {
                isActive = false;
            }
        }
    })();
    </script>
    <script>
        window.SITE_BASE_URL = "{{ '/' | url }}";
    </script>
    {% block scripts %}{% endblock %}
</body>

</html>
