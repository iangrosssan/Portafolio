<header class="panel" style="padding: 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 1rem;">
    <h1 class="hero-title" style="font-size: 2rem; margin-bottom: 0;">{{ site.name }}</h1>
    <div class="author" style="margin-top: 0; gap: 1.5rem;">
        <a href="{{ site.links.cv | url }}" target="_blank" aria-label="CV" style="font-size: 0; padding: 0.5rem;" title="CV">CV</a>
        <a href="{{ site.links.github }}" target="_blank" aria-label="GitHub" style="font-size: 0; padding: 0.5rem;" title="GitHub">GitHub</a>
        <a href="{{ site.links.linkedin }}" target="_blank" aria-label="LinkedIn" style="font-size: 0; padding: 0.5rem;" title="LinkedIn">LinkedIn</a>
        <a href="{{ site.links.youtube }}" target="_blank" aria-label="YouTube" style="font-size: 0; padding: 0.5rem;" title="YouTube">YouTube</a>
        <a href="{{ site.links.instagram }}" target="_blank" aria-label="Instagram" style="font-size: 0; padding: 0.5rem;" title="Instagram">Instagram</a>
    </div>
</header>
