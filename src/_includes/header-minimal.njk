<header class="panel" style="padding: 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 1rem;">
    <h1 class="hero-title" style="font-size: 2rem; margin-bottom: 0;">{{ site.name }}</h1>
    <div class="author" style="margin-top: 0; gap: 1.5rem;">
        <a href="{{ site.links.cv | url }}" target="_blank" aria-label="CV" class="mobile-icon-only" title="CV">CV</a>
        <a href="{{ site.links.github }}" target="_blank" aria-label="GitHub" class="mobile-icon-only" title="GitHub">GitHub</a>
        <a href="{{ site.links.linkedin }}" target="_blank" aria-label="LinkedIn" class="mobile-icon-only" title="LinkedIn">LinkedIn</a>
        <a href="{{ site.links.youtube }}" target="_blank" aria-label="YouTube" class="mobile-icon-only" title="YouTube">YouTube</a>
        <a href="{{ site.links.instagram }}" target="_blank" aria-label="Instagram" class="mobile-icon-only" title="Instagram">Instagram</a>
    </div>
</header>
