<header class="panel" style="padding: 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; position: relative; overflow: hidden;">
    <div class="smoke-container">
        <div class="smoke-wisp wisp-1" id="wisp-1"></div>
        <div class="smoke-wisp wisp-2" id="wisp-2"></div>
        <div class="smoke-wisp wisp-3" id="wisp-3"></div>
    </div>
    <h1 class="hero-title" style="font-size: 2rem; margin-bottom: 0;">{{ site.name }}</h1>
    <div class="author socials-static" style="margin-top: 0; gap: 0.75rem; flex-wrap: wrap;">
        <a href="{{ site.links.cv | url }}" target="_blank" aria-label="Curriculum" class="social-button" title="Curriculum"><span class="social-text">Curriculum</span></a>
        <a href="{{ site.links.github }}" target="_blank" aria-label="GitHub" class="social-button" title="GitHub"><span class="social-text">GitHub</span></a>
        <a href="{{ site.links.linkedin }}" target="_blank" aria-label="LinkedIn" class="social-button" title="LinkedIn"><span class="social-text">LinkedIn</span></a>
        <a href="{{ site.links.youtube }}" target="_blank" aria-label="YouTube" class="social-button" title="YouTube"><span class="social-text">YouTube</span></a>
        <a href="{{ site.links.instagram }}" target="_blank" aria-label="Instagram" class="social-button" title="Instagram"><span class="social-text">Instagram</span></a>
    </div>

    <div class="repo-buttons" style="margin-top: 0.5rem; width: 100%; max-width: 850px;">
        <a href="{{ '/repo_academico/' | url }}" class="section-item{% if activeRepo == 'academico' %} active{% endif %}"><span class="repo-text">Repositorio Académico</span></a>
        <a href="{{ '/repo_codigo/' | url }}" class="section-item{% if activeRepo == 'codigo' %} active{% endif %}"><span class="repo-text">Repositorio de Código</span></a>
    </div>
</header>
