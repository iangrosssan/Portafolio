---
layout: base.njk
pageTitle: Portafolio
---

<div class="page">

    <header class="panel" id="hero-panel">
        <div class="smoke-container">
            <div class="smoke-wisp wisp-1" id="wisp-1"></div>
            <div class="smoke-wisp wisp-2" id="wisp-2"></div>
            <div class="smoke-wisp wisp-3" id="wisp-3"></div>
        </div>

        <h1 class="hero-title">{{ site.name }}</h1>

        <div class="hero-stack">
            <span>Egresado de Ingeniería Civil Mecánica</span>
            <span>Mayor en Ingeniería Física</span>
            <span>Minor en Matemática aplicada</span>
        </div>

        <p class="hero-lead">{{ site.lead }}</p>

        <div class="author" style="margin-top: 3rem; justify-content: center; gap: 0.75rem; flex-direction: column; align-items: center;">
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;">
                <a href="{{ site.links.cv | url }}" target="_blank" aria-label="Curriculum" class="social-button" title="Curriculum"><span class="social-text">Curriculum</span></a>
                <a href="{{ site.links.github }}" target="_blank" aria-label="GitHub" class="social-button" title="GitHub"><span class="social-text">GitHub</span></a>
                <a href="{{ site.links.linkedin }}" target="_blank" aria-label="LinkedIn" class="social-button" title="LinkedIn"><span class="social-text">LinkedIn</span></a>
            </div>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;">
                <a href="{{ site.links.youtube }}" target="_blank" aria-label="YouTube" class="social-button" title="YouTube"><span class="social-text">YouTube</span></a>
                <a href="{{ site.links.instagram }}" target="_blank" aria-label="Instagram" class="social-button" title="Instagram"><span class="social-text">Instagram</span></a>
            </div>
        </div>

        <div class="repo-buttons" style="margin-top: 3.5rem;">
            <a href="{{ '/repo_academico/' | url }}" class="section-item"><span class="repo-text">Repositorio Académico</span></a>
            <a href="{{ '/repo_codigo/' | url }}" class="section-item"><span class="repo-text">Repositorio de Código</span></a>
        </div>
    </header>


    <footer style="margin-top: 4rem; border: none; padding-bottom: 0;">
        <span class="footer-center">© {{ site.name }} — Portafolio personal</span>
    </footer>

</div>
