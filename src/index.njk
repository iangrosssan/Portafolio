---
layout: base.njk
pageTitle: Portafolio
---

<div class="page">

    <header class="panel" id="hero-panel">
        <div class="smoke-container">
            <div class="smoke-wisp wisp-1" id="wisp-1"></div>
            <div class="smoke-wisp wisp-2" id="wisp-2"></div>
            <div class="smoke-wisp wisp-3" id="wisp-3"></div>
        </div>

        <h1 class="hero-title">{{ site.name }}</h1>

        <div class="hero-stack">
            <span>Egresado de Ingeniería Civil en Aeroespacial</span>
            <span>Mayor en Estructuras y Materiales Aeroespaciales</span>
            <span>Minor en Gestión de Proyectos</span>
        </div>

        <p class="hero-lead">{{ site.lead }}</p>

        <div class="author" style="margin-top: 3rem; justify-content: center; gap: 0.75rem; flex-direction: column; align-items: center;">
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;">
                <a href="{{ site.links.cv | url }}" target="_blank" aria-label="Curriculum" class="social-button" title="Curriculum"><span class="social-text">Curriculum</span></a>
                <a href="{{ site.links.github }}" target="_blank" aria-label="GitHub" class="social-button" title="GitHub"><span class="social-text">GitHub</span></a>
                <a href="{{ site.links.linkedin }}" target="_blank" aria-label="LinkedIn" class="social-button" title="LinkedIn"><span class="social-text">LinkedIn</span></a>
            </div>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;">
                <a href="{{ site.links.youtube }}" target="_blank" aria-label="YouTube" class="social-button" title="YouTube"><span class="social-text">YouTube</span></a>
                <a href="{{ site.links.instagram }}" target="_blank" aria-label="Instagram" class="social-button" title="Instagram"><span class="social-text">Instagram</span></a>
            </div>
        </div>

        <div style="margin-top: 3.5rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem;">
            <a href="{{ '/repo_academico/' | url }}" class="section-item"
                style="width: auto; padding: 1rem 2rem; font-size: 1.1rem; text-decoration: none; text-align: center; border-radius: 2rem;"><span class="repo-text">Ver
                Repositorio Académico</span></a>
            <a href="{{ '/repo_codigo/' | url }}" class="section-item"
                style="width: auto; padding: 1rem 2rem; font-size: 1.1rem; text-decoration: none; text-align: center; border-radius: 2rem;"><span class="repo-text">Ver
                Repositorio de Código</span></a>
        </div>
    </header>

    <script>
    (function() {
        const panel = document.getElementById('hero-panel');
        const wisps = [
            { el: document.getElementById('wisp-1'), x: 0, y: 0, targetX: 0, targetY: 0, lag: 0.15, drift: 0 },
            { el: document.getElementById('wisp-2'), x: 0, y: 0, targetX: 0, targetY: 0, lag: 0.08, drift: 0.02 },
            { el: document.getElementById('wisp-3'), x: 0, y: 0, targetX: 0, targetY: 0, lag: 0.04, drift: 0.05 }
        ];

        let mouseX = 0, mouseY = 0;
        let isActive = false;
        let rAF = null;

        function updateTracking(e) {
            mouseX = e.clientX;
            mouseY = e.clientY;
            if (!isActive) {
                isActive = true;
                wisps.forEach(w => w.el.style.opacity = '1');
                animate();
            }
        }

        panel.addEventListener('mousemove', updateTracking);
        panel.addEventListener('mouseenter', () => {
            wisps.forEach(w => w.el.style.opacity = '1');
        });

        function animate() {
            let moving = false;
            const now = Date.now() * 0.001;

            wisps.forEach((w, i) => {
                // Individual drift
                const driftX = Math.sin(now + i) * 30 * w.drift;
                const driftY = Math.cos(now * 0.7 + i) * 20 * w.drift;
                
                const targetX = mouseX + driftX;
                const targetY = mouseY + driftY;

                w.x += (targetX - w.x) * w.lag;
                w.y += (targetY - w.y) * w.lag;

                const dx = Math.abs(targetX - w.x);
                const dy = Math.abs(targetY - w.y);

                if (dx > 0.1 || dy > 0.1) moving = true;

                const rect = panel.getBoundingClientRect();
                const rotate = Math.sin(now * 0.5 + i) * 15 * w.drift;
                const scale = 1 + Math.sin(now + i) * 0.1 * w.drift;

                // Center based on panel origin
                const offsetX = w.el.offsetWidth / 2;
                const offsetY = w.el.offsetHeight / 2;

                w.el.style.transform = `translate(${w.x - rect.left - offsetX}px, ${w.y - rect.top - offsetY}px) rotate(${rotate}deg) scale(${scale})`;
            });

            // Set main global variables on the panel for inking
            const rect = panel.getBoundingClientRect();
            panel.style.setProperty('--glow-x', (wisps[0].x - rect.left) + 'px');
            panel.style.setProperty('--glow-y', (wisps[0].y - rect.top) + 'px');

            if (moving || isActive) {
                rAF = requestAnimationFrame(animate);
            } else {
                isActive = false;
            }
        }
    })();
    </script>

    <footer style="margin-top: 4rem; border: none; padding-bottom: 0;">
        <span class="footer-center">© {{ site.name }} — Portafolio personal</span>
    </footer>

</div>
